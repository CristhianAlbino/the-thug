  "blocks": [
    {
      "id": "N01",
      "cues": [
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "A polícia não vai subir até aqui. Temos alguns minutos.",
          "id": "N01:0"
        },
        {
          "kind": "speech",
          "speaker": "bartholomeu",
          "text": "A porta não fecha.",
          "id": "N01:1"
        },
        {
          "kind": "speech",
          "speaker": "thomas",
          "text": "Olha pra mim, pequeno. No três a gente empurra junto.",
          "actors": [
            "bartholomeu"
          ],
          "id": "N01:2"
        },
        {
          "kind": "speech",
          "speaker": "harley",
          "text": "Você deixou isso. De novo.",
          "id": "N01:3"
        },
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Guarda. Conversamos lá em cima.",
          "actors": [
            "harley"
          ],
          "id": "N01:4"
        },
        {
          "kind": "speech",
          "speaker": "harley",
          "text": "Você sempre promete.",
          "id": "N01:5"
        },
        {
          "kind": "gesture",
          "asset": "thomas_checks_barth_hand",
          "text": "",
          "actors": [
            "thomas",
            "bartholomeu"
          ],
          "id": "N01:6"
        }
      ]
    },
    {
      "id": "N02",
      "cues": [
        {
          "kind": "speech",
          "speaker": "thomas",
          "text": "É só um morcego fantasiado. Relaxa. Quando a gente sair, pago café pra todo mundo.",
          "delivered_fact": "thomas_promised_coffee",
          "id": "N02:0"
        },
        {
          "kind": "speech",
          "speaker": "bartholomeu",
          "text": "Você disse isso na última vez.",
          "actors": [
            "thomas"
          ],
          "id": "N02:1"
        },
        {
          "kind": "speech",
          "speaker": "thomas",
          "text": "Paguei, não paguei?",
          "actors": [
            "bartholomeu"
          ],
          "id": "N02:2"
        },
        {
          "kind": "speech",
          "speaker": "harley",
          "text": "Eu não ficaria na janela.",
          "id": "N02:3"
        },
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Sai daí, Thomas.",
          "actors": [
            "thomas"
          ],
          "id": "N02:4"
        },
        {
          "kind": "speech",
          "speaker": "jack",
          "text": "Já cruzei com ele. Saí vivo. A janela não é o único lugar por onde alguém entra.",
          "delivered_fact": "jack_previous_encounter_heard",
          "id": "N02:5"
        },
        {
          "kind": "gesture",
          "asset": "distant_batsignal",
          "text": "",
          "id": "N02:6"
        }
      ]
    },
    {
      "id": "N03",
      "cues": [
        {
          "kind": "speech",
          "speaker": "thomas",
          "text": "Merda, que foi isso—",
          "id": "N03:0"
        },
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Thomas?!",
          "id": "N03:1"
        },
        {
          "kind": "speech",
          "speaker": "harley",
          "text": "Barth, vem comigo. Joe, olha pra mim. Agora anda.",
          "actors": [
            "bartholomeu"
          ],
          "id": "N03:2"
        },
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Não foi a polícia.",
          "id": "N03:3"
        }
      ]
    },
    {
      "id": "N04",
      "cues": [
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Foi o carrinho. Preciso sair daqui.",
          "all": [
            "joe_cart_noise_observed"
          ],
          "id": "N04:0"
        },
        {
          "kind": "gesture",
          "asset": "quiet_corridor",
          "text": "",
          "all": [
            "quiet_corridor_observed"
          ],
          "id": "N04:1"
        }
      ]
    },
    {
      "id": "N05",
      "cues": [
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Ele passou aqui?",
          "all": [
            "ambiguous_trace_observed"
          ],
          "id": "N05:0"
        },
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Registro de frota. Vou guardar.",
          "all": [
            "doc01_read"
          ],
          "none": [
            "doc05_read"
          ],
          "id": "N05:1"
        },
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Uma das referências. Ainda preciso conferir as outras.",
          "all": [
            "doc01_read",
            "doc05_read"
          ],
          "id": "N05:2"
        }
      ]
    },
    {
      "id": "N06",
      "cues": [
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "O mesmo cano. Esse andar volta para o outro lado.",
          "all": [
            "pipe_landmark_observed"
          ],
          "id": "N06:0"
        },
        {
          "kind": "gesture",
          "asset": "ambient_navigation",
          "text": "",
          "id": "N06:1"
        }
      ]
    },
    {
      "id": "N07",
      "cues": [
        {
          "kind": "speech",
          "speaker": "harley",
          "text": "Você tá sangrando.",
          "all": [
            "joe_bleeding"
          ],
          "id": "N07:0"
        },
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Não é nada.",
          "all": [
            "joe_bleeding"
          ],
          "id": "N07:1"
        },
        {
          "kind": "speech",
          "speaker": "harley",
          "text": "Não mente pra mim. Já vi você mentir melhor.",
          "all": [
            "joe_bleeding"
          ],
          "id": "N07:2"
        },
        {
          "kind": "speech",
          "speaker": "harley",
          "text": "Ouvi a porta bater, não vi quem entrou.",
          "all": [
            "harley_heard_unseen_door"
          ],
          "none": [
            "joe_injured"
          ],
          "id": "N07:3"
        },
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Você consegue andar?",
          "all": [
            "harley_injured"
          ],
          "modes": [
            "Easy",
            "Normal",
            "Hard"
          ],
          "id": "N07:4"
        },
        {
          "kind": "speech",
          "speaker": "harley",
          "text": "Consigo. Era só isso?",
          "all": [
            "harley_injured"
          ],
          "modes": [
            "Easy",
            "Normal",
            "Hard"
          ],
          "id": "N07:5"
        },
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Deixa eu ver. Se ficar pior, eu volto por você.",
          "all": [
            "harley_injured"
          ],
          "modes": [
            "Punitive"
          ],
          "id": "N07:6"
        },
        {
          "kind": "speech",
          "speaker": "harley",
          "text": "Então me diz por onde.",
          "all": [
            "harley_injured"
          ],
          "modes": [
            "Punitive"
          ],
          "id": "N07:7"
        }
      ]
    },
    {
      "id": "N08",
      "cues": [
        {
          "kind": "speech",
          "speaker": "jack",
          "text": "Na primeira, veio pelo barulho. Na segunda, pela escada.",
          "all": [
            "jack_two_encounters_observed"
          ],
          "id": "N08:0"
        },
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Ele sabe o caminho?",
          "all": [
            "jack_two_encounters_observed"
          ],
          "id": "N08:1"
        },
        {
          "kind": "speech",
          "speaker": "jack",
          "text": "Sabe o que você mostrou.",
          "all": [
            "jack_two_encounters_observed"
          ],
          "id": "N08:2"
        },
        {
          "kind": "speech",
          "speaker": "jack",
          "text": "A porta está aberta. O resto é palpite.",
          "all": [
            "jack_open_door_observed"
          ],
          "none": [
            "jack_two_encounters_observed"
          ],
          "id": "N08:3"
        },
        {
          "kind": "speech",
          "speaker": "jack",
          "text": "Esse hospital recebe muito bem.",
          "all": [
            "jack_heard_thomas_or_injury"
          ],
          "modes": [
            "Punitive"
          ],
          "id": "N08:4"
        },
        {
          "kind": "gesture",
          "asset": "jack_j1_laugh",
          "text": "",
          "all": [
            "jack_heard_thomas_or_injury"
          ],
          "modes": [
            "Punitive"
          ],
          "actors": [
            "jack"
          ],
          "id": "N08:5"
        }
      ]
    },
    {
      "id": "N09",
      "cues": [
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "A hora está andando.",
          "all": [
            "live_feed_observed"
          ],
          "id": "N09:0"
        },
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "O mesmo reflexo. Isso já aconteceu.",
          "all": [
            "loop_feed_observed"
          ],
          "id": "N09:1"
        },
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Nada de imagem.",
          "all": [
            "offline_feed_observed"
          ],
          "id": "N09:2"
        }
      ]
    },
    {
      "id": "N10",
      "cues": [
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "A câmera mostrou o que havia, não o que há.",
          "all": [
            "camera_area_physically_checked"
          ],
          "id": "N10:0"
        },
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Pode ser antigo.",
          "none": [
            "camera_area_physically_checked"
          ],
          "id": "N10:1"
        }
      ]
    },
    {
      "id": "N11",
      "cues": [
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Pensa, Joe. Pensa.",
          "id": "N11:0"
        },
        {
          "kind": "gesture",
          "asset": "hunter_arrival_physical",
          "text": "",
          "id": "N11:1"
        }
      ]
    },
    {
      "id": "N12",
      "cues": [
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Tem remédio. O caminho até ele é o problema.",
          "all": [
            "joe_injured"
          ],
          "id": "N12:0"
        },
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Posso precisar disso depois.",
          "none": [
            "joe_injured"
          ],
          "id": "N12:1"
        }
      ]
    },
    {
      "id": "N13",
      "cues": [
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Tem carro. A chave ficou num cofre lá em cima.",
          "all": [
            "doc04_read"
          ],
          "id": "N13:0"
        }
      ]
    },
    {
      "id": "N14",
      "cues": [
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Três referências. Leitos, arquivo, manutenção.",
          "all": [
            "doc05_read"
          ],
          "id": "N14:0"
        },
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Agora a chave.",
          "all": [
            "key_inside_safe_observed"
          ],
          "id": "N14:1"
        },
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Não abriu. Preciso conferir.",
          "all": [
            "keypad_failure_observed"
          ],
          "id": "N14:2"
        }
      ]
    },
    {
      "id": "N15",
      "cues": [
        {
          "kind": "speech",
          "speaker": "bartholomeu",
          "text": "Vi uma entrada perto das bombas. Não vi saída. Você sempre me disse pra falar só do que vi, Joe.",
          "all": [
            "barth_tunnel_entry_observed"
          ],
          "id": "N15:0"
        },
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Vem mostrar.",
          "all": [
            "joe_requested_tunnel_guidance"
          ],
          "id": "N15:1"
        },
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Guarda isso pra você.",
          "all": [
            "joe_declined_tunnel_guidance"
          ],
          "id": "N15:2"
        },
        {
          "kind": "speech",
          "speaker": "bartholomeu",
          "text": "Eu vou lembrar. É bom saber que você ainda confia em mim.",
          "all": [
            "joe_shared_ammo_with_bartholomeu"
          ],
          "id": "N15:3"
        },
        {
          "kind": "speech",
          "speaker": "bartholomeu",
          "text": "Pode estar morto, Joe. Eu não vi.",
          "all": [
            "thomas_discussed"
          ],
          "modes": [
            "Easy",
            "Normal"
          ],
          "id": "N15:4"
        },
        {
          "kind": "speech",
          "speaker": "bartholomeu",
          "text": "Thomas morreu",
          "all": [
            "barth_informed_of_thomas_proof"
          ],
          "modes": [
            "Hard",
            "Punitive"
          ],
          "id": "N15:5"
        },
        {
          "kind": "speech",
          "speaker": "jack",
          "text": "Até o hospital deve ter desistido de achar esse homem.",
          "all": [
            "jack_act3_encounter",
            "jack_heard_thomas_or_injury"
          ],
          "modes": [
            "Punitive"
          ],
          "id": "N15:6"
        },
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Não fala dele assim.",
          "all": [
            "jack_act3_encounter",
            "jack_heard_thomas_or_injury"
          ],
          "modes": [
            "Punitive"
          ],
          "actors": [
            "jack"
          ],
          "id": "N15:7"
        },
        {
          "kind": "gesture",
          "asset": "jack_j2_laugh",
          "text": "",
          "all": [
            "jack_act3_encounter",
            "jack_heard_thomas_or_injury"
          ],
          "modes": [
            "Punitive"
          ],
          "actors": [
            "jack"
          ],
          "id": "N15:8"
        }
      ]
    },
    {
      "id": "N16",
      "cues": [
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Se eu ligar isso, alguém vai ouvir.",
          "all": [
            "generator_heard"
          ],
          "id": "N16:0"
        }
      ]
    },
    {
      "id": "N17",
      "cues": [
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Ele não passa por esse vão. Pode dar a volta.",
          "all": [
            "pipe_opening_assessed"
          ],
          "id": "N17:0"
        }
      ]
    },
    {
      "id": "N18",
      "cues": [
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Ali é outro prédio.",
          "all": [
            "annex_seen"
          ],
          "id": "N18:0"
        },
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Uma ida só.",
          "all": [
            "window_unblocked"
          ],
          "id": "N18:1"
        },
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Preciso de algo que tire a trava.",
          "all": [
            "window_blocked_observed"
          ],
          "none": [
            "window_unblocked"
          ],
          "id": "N18:2"
        }
      ]
    },
    {
      "id": "N19",
      "cues": [
        {
          "kind": "speech",
          "speaker": "radio",
          "text": "Repete o ponto. Não pouso às cegas.",
          "all": [
            "radio_contact_established"
          ],
          "id": "N19:0"
        },
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Telhado do hospital. Confirma.",
          "all": [
            "radio_contact_established"
          ],
          "id": "N19:1"
        },
        {
          "kind": "speech",
          "speaker": "radio",
          "text": "Confirmado. Cinco minutos.",
          "all": [
            "helicopter_confirmed"
          ],
          "id": "N19:2"
        }
      ]
    },
    {
      "id": "N20",
      "cues": [
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Água vai para algum lugar.",
          "all": [
            "water_current_observed"
          ],
          "id": "N20:0"
        },
        {
          "kind": "speech",
          "speaker": "bartholomeu",
          "text": "Eu vi a entrada, agora ouvi o ar lá dentro.",
          "all": [
            "barth_tunnel_entry_observed",
            "barth_tunnel_air_heard"
          ],
          "id": "N20:1"
        }
      ]
    },
    {
      "id": "N21",
      "cues": [
        {
          "kind": "speech",
          "speaker": "jack",
          "text": "Ele parou de procurar o andar. Está esperando sua escada.",
          "all": [
            "jack_hunter_habit_observed"
          ],
          "id": "N21:0"
        },
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Então mudamos de escada.",
          "all": [
            "jack_hunter_habit_observed"
          ],
          "actors": [
            "jack"
          ],
          "id": "N21:1"
        }
      ]
    },
    {
      "id": "N22",
      "cues": [
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Caiu a segurança.",
          "all": [
            "security_blackout_observed"
          ],
          "id": "N22:0"
        },
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "O controle da porta não responde",
          "all": [
            "closed_powered_door_attempt_failed"
          ],
          "id": "N22:1"
        },
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Voltou a energia. Preciso conferir a imagem.",
          "all": [
            "security_power_restored_observed"
          ],
          "id": "N22:2"
        },
        {
          "kind": "gesture",
          "asset": "service_power_effect",
          "text": "",
          "all": [
            "service_power_effect_observed"
          ],
          "id": "N22:3"
        }
      ]
    },
    {
      "id": "N23",
      "cues": [
        {
          "kind": "speech",
          "speaker": "harley",
          "text": "Você ouviu quando pedi ajuda?",
          "all": [
            "joe_heard_harley_help_request"
          ],
          "modes": [
            "Easy",
            "Normal",
            "Hard"
          ],
          "id": "N23:0"
        },
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Ouvi. Estou vendo se dá pra passar.",
          "all": [
            "joe_heard_harley_help_request"
          ],
          "modes": [
            "Easy",
            "Normal",
            "Hard"
          ],
          "id": "N23:1"
        },
        {
          "kind": "speech",
          "speaker": "harley",
          "text": "Eu perguntei de mim.",
          "all": [
            "joe_heard_harley_help_request"
          ],
          "modes": [
            "Easy",
            "Normal",
            "Hard"
          ],
          "id": "N23:2"
        },
        {
          "kind": "speech",
          "speaker": "harley",
          "text": "Barth ainda está esperando por nós.",
          "all": [
            "harley_knows_barth_alive_waiting"
          ],
          "modes": [
            "Easy",
            "Normal",
            "Hard"
          ],
          "id": "N23:3"
        },
        {
          "kind": "speech",
          "speaker": "harley",
          "text": "Consigo ir. Você não precisa voltar.",
          "modes": [
            "Punitive"
          ],
          "id": "N23:4"
        },
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "Preciso saber que você chegou.",
          "modes": [
            "Punitive"
          ],
          "id": "N23:5"
        },
        {
          "kind": "speech",
          "speaker": "harley",
          "text": "Eu vi você voltar",
          "all": [
            "joe_returned_for_harley"
          ],
          "id": "N23:6"
        },
        {
          "kind": "speech",
          "speaker": "harley",
          "text": "Então vou por mim.",
          "all": [
            "joe_abandoned_harley"
          ],
          "id": "N23:7"
        }
      ]
    },
    {
      "id": "N24",
      "cues": [
        {
          "kind": "speech",
          "speaker": "bartholomeu",
          "text": "Segurei a porta quando entramos. O Thomas me ajudou.",
          "all": [
            "barth_held_opening_door"
          ],
          "id": "N24:0"
        },
        {
          "kind": "speech",
          "speaker": "joe",
          "text": "E agora?",
          "all": [
            "barth_held_opening_door"
          ],
          "id": "N24:1"
        },
        {
          "kind": "speech",
          "speaker": "bartholomeu",
          "text": "Agora é você que decide se a deixa aberta. Eu já fiz isso por você, lembra?",
          "all": [
            "barth_held_opening_door"
