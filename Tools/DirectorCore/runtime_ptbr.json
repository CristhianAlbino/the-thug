    {
      "id": "E_HARLEY_TOGETHER_ASYMMETRIC",
      "cues": [
        {
          "kind": "epilogue",
          "text": "Ela saiu ao lado dele. Sobreviver juntos ainda não respondia tudo que havia entre os dois.",
          "id": "E_HARLEY_TOGETHER_ASYMMETRIC:0"
        }
      ],
      "modes": [
        "Easy",
        "Normal",
        "Hard"
      ]
    },
    {
      "id": "E_HARLEY_TOGETHER_RECIPROCAL",
      "cues": [
        {
          "kind": "epilogue",
          "text": "Do lado de fora, Harley procurou o olhar de Joe.",
          "id": "E_HARLEY_TOGETHER_RECIPROCAL:0"
        }
      ],
      "modes": [
        "Punitive"
      ]
    },
    {
      "id": "E_HARLEY_ALONE",
      "cues": [
        {
          "kind": "epilogue",
          "text": "Harley encontrou uma saída por conta própria. A travessia seguinte teria de ser dela.",
          "id": "E_HARLEY_ALONE:0"
        }
      ]
    },
    {
      "id": "E_HARLEY_CAPTURED",
      "cues": [
        {
          "kind": "epilogue",
          "text": "Harley foi capturada. Depois disso, nenhuma notícia foi confirmada.",
          "id": "E_HARLEY_CAPTURED:0"
        }
      ]
    },
    {
      "id": "E_HARLEY_DEAD",
      "cues": [
        {
          "kind": "epilogue",
          "text": "A voz que chamava os outros pelo nome não voltaria a responder.",
          "id": "E_HARLEY_DEAD:0"
        }
      ]
    },
    {
      "id": "E_HARLEY_UNKNOWN",
      "cues": [
        {
          "kind": "epilogue",
          "text": "Joe a perdeu de vista. Não chegou notícia de fuga, captura ou morte.",
          "id": "E_HARLEY_UNKNOWN:0"
        }
      ]
    },
    {
      "id": "E_BARTH_TOGETHER",
      "cues": [
        {
          "kind": "epilogue",
          "text": "Bartholomeu atravessou a saída ao lado de Joe. Ainda tremia. Estava vivo.",
          "id": "E_BARTH_TOGETHER:0"
        }
      ]
    },
    {
      "id": "E_BARTH_ALONE",
      "cues": [
        {
          "kind": "epilogue",
          "text": "Ele encontrou outra saída. Pela primeira vez naquela noite, teria de decidir o próximo passo sem Joe.",
          "id": "E_BARTH_ALONE:0"
        }
      ]
    },
    {
      "id": "E_BARTH_CAPTURED",
      "cues": [
        {
          "kind": "epilogue",
          "text": "Bartholomeu foi capturado antes de alcançar a saída.",
          "id": "E_BARTH_CAPTURED:0"
        }
      ]
    },
    {
      "id": "E_BARTH_DEAD",
      "cues": [
        {
          "kind": "epilogue",
          "text": "O amigo que tremia na escada não sairia do hospital.",
          "id": "E_BARTH_DEAD:0"
        }
      ]
    },
    {
      "id": "E_BARTH_UNKNOWN",
      "cues": [
        {
          "kind": "epilogue",
          "text": "Depois do último contato, não houve resposta sobre Bartholomeu.",
          "id": "E_BARTH_UNKNOWN:0"
        }
      ]
    },
    {
      "id": "E_JACK_TOGETHER",
      "cues": [
        {
          "kind": "epilogue",
          "text": "Jack saiu ao lado de Joe. Nem todas as perguntas saíram com uma resposta.",
          "id": "E_JACK_TOGETHER:0"
        }
      ]
    },
    {
      "id": "E_JACK_ALONE",
      "cues": [
        {
          "kind": "epilogue",
          "text": "A fuga dele foi confirmada por caminho próprio.",
          "id": "E_JACK_ALONE:0"
        }
      ]
    },
    {
      "id": "E_JACK_CAPTURED",
      "cues": [
        {
          "kind": "epilogue",
          "text": "O último fato confirmado é a captura.",
          "id": "E_JACK_CAPTURED:0"
        }
      ]
    },
    {
      "id": "E_JACK_DEAD",
      "cues": [
        {
          "kind": "epilogue",
          "text": "A fuga de Jack terminou no hospital.",
          "id": "E_JACK_DEAD:0"
        }
      ]
    },
    {
      "id": "E_JACK_UNKNOWN",
      "cues": [
        {
          "kind": "epilogue",
          "text": "Sumiu dos trajetos que Joe podia verificar.",
          "id": "E_JACK_UNKNOWN:0"
        }
      ]
